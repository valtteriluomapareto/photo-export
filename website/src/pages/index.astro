---
import { Image } from 'astro:assets';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Footer from '../components/Footer.astro';
import screenshot from '../assets/photo_export_screenshot.png';

const base = import.meta.env.BASE_URL;
const title = 'Photo Export — Free Mac App to Back Up iCloud & Apple Photos';
const description =
	'Free, open-source macOS app to back up your iCloud and Apple Photos library to any external drive — entire library, your Favorites, or a single album. No subscription, no cloud services.';

const faqData = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'Does this work with iCloud Photo Library?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Yes. Photo Export reads your Apple Photos library, which includes all photos synced via iCloud. It can also download iCloud originals that are stored remotely on demand during export.',
			},
		},
		{
			'@type': 'Question',
			name: 'Can I export photos to an external hard drive?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Absolutely. You can choose any local or external drive as your export destination. The app remembers your choice across launches.',
			},
		},
		{
			'@type': 'Question',
			name: 'Will it download iCloud originals that are stored remotely?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Yes. During export, the app automatically downloads originals from iCloud when they are not stored locally on your Mac. No manual downloading required.',
			},
		},
		{
			'@type': 'Question',
			name: 'Is Photo Export free?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Photo Export is free and open source on GitHub Releases. It is also available as a paid app on the Mac App Store — the purchase supports ongoing development. Both versions are identical in functionality.',
			},
		},
		{
			'@type': 'Question',
			name: 'Does it export videos too?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Yes. The app exports photos and videos. Live Photos are exported as a single still image — full motion export (paired image + video) is planned for a future release.',
			},
		},
		{
			'@type': 'Question',
			name: 'How do I export a single album from Apple Photos?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Yes — you can export your Favorites or any individual album to its own folder on your drive. Photo Export lists everything you've created in Photos under a Collections tab in the sidebar; pick one and click Export. Albums land at Collections/Albums/<Album>/ (folder hierarchy preserved); Favorites land at Collections/Favorites/. Smart albums other than Favorites and shared albums aren't included. Timeline (year/month) export still works exactly as before.",
			},
		},
		{
			'@type': 'Question',
			name: 'What about photos I have edited in Photos?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'By default Photo Export saves the version Photos shows you, edits included, at the original filename. Turn on the "Include originals" toggle in the toolbar to also keep an original-bytes copy as a _orig companion (for example IMG_0001_orig.HEIC alongside IMG_0001.JPG).',
			},
		},
		{
			'@type': 'Question',
			name: 'What happens if the export is interrupted?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'The app tracks every exported photo. If the export is interrupted, you can resume and it will skip most already-exported files. In rare cases (e.g. a crash mid-write), a file may be copied again.',
			},
		},
	],
};
---

<MarketingLayout title={title} description={description}>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(faqData)}
		slot="head"
	/>
	<Hero />

	<!-- Why Photo Export? -->
	<section class="section" aria-labelledby="why-photo-export">
		<div class="container">
			<h2 id="why-photo-export">
				Why Use Photo Export for Your iCloud Backup?
			</h2>
			<p class="section-lead">
				Photo Export uses Apple's <strong>PhotoKit framework</strong> — the same system
				API that powers the built-in Photos app. It sees exactly what your Photos
				app sees: every photo, video, and album synced through iCloud Photos. No reverse
				engineering, no private APIs, no workarounds.
			</p>
			<p class="section-lead">
				This matters because PhotoKit is <strong>the only supported way</strong> to
				read the Photos library on macOS. It means the app works reliably across macOS
				updates, respects your privacy settings, and can request iCloud originals
				on demand through Apple's own infrastructure. The app never asks for your
				Apple Account password, and reads your library <strong>read-only</strong> —
				it can't modify or delete anything in Photos.
			</p>
			<div class="value-props">
				<div class="value-prop">
					<strong>Your photos, your folders</strong>
					<span
						>No cloud lock-in. Export originals to any drive you control.</span
					>
				</div>
				<div class="value-prop">
					<strong>Two ways to navigate</strong>
					<span
						>Browse year by year and month by month, or by your
						<strong>Favorites</strong> and the <strong>albums</strong> you've created
						in Photos. Pick the view that fits your library.</span
					>
				</div>
				<div class="value-prop">
					<strong>Only exports new photos</strong>
					<span
						>Skips files you've already exported. Handles filename collisions
						safely — never overwrites an existing file.</span
					>
				</div>
				<div class="value-prop">
					<strong>Handles interruptions</strong>
					<span
						>Pause, resume, and recover from interruptions. Individual failures
						don't stop the batch.</span
					>
				</div>
			</div>
		</div>
	</section>

	<!-- Features -->
	<section class="section section-alt" aria-labelledby="features">
		<div class="container">
			<h2 id="features">Features</h2>
			<div class="feature-grid">
				<FeatureCard title="Two Ways to Browse" icon="📸">
					Find any photo fast — by the date you took it, or by the album you
					saved it to. Photo counts and export status at a glance.
				</FeatureCard>
				<FeatureCard title="Export by Album" icon="❤️">
					Back up just your Favorites, or one specific album, in one step.
					Albums under Photos folders preserve their hierarchy on disk, e.g. <code
						>Collections/Albums/Trips/Iceland/</code
					>.
				</FeatureCard>
				<FeatureCard title="Thumbnail Previews" icon="🖼">
					Fast thumbnail grid with in-memory caching. Click any photo for a
					full-size preview.
				</FeatureCard>
				<FeatureCard title="Edits Included" icon="✨">
					Exports the version Photos shows you — edits and all — at the original
					filename. Toggle <strong>Include originals</strong> to also keep <code
						>_orig</code
					> companions with the original bytes.
				</FeatureCard>
				<FeatureCard title="Smart Export Tracking" icon="✅">
					Remembers every exported photo. Resume-safe — never re-exports what's
					already been copied.
				</FeatureCard>
				<FeatureCard title="Pause / Resume / Cancel" icon="⏯">
					Full control over the export queue. Pause a long export and pick it up
					later.
				</FeatureCard>
				<FeatureCard title="Remembers Your Folder" icon="📁">
					Your chosen destination folder is remembered across app launches — no
					need to re-select it.
				</FeatureCard>
				<FeatureCard title="Graceful Error Handling" icon="🛡">
					Handles denied access, unavailable drives, and individual photo
					failures without crashing the batch.
				</FeatureCard>
			</div>
		</div>
	</section>

	<!-- How It Works -->
	<section class="section" aria-labelledby="how-it-works">
		<div class="container">
			<h2 id="how-it-works">How to Export Your iCloud Photos in 3 Steps</h2>
			<p class="section-note">
				<strong>Prerequisite:</strong> Make sure iCloud Photos is enabled on your
				Mac (<strong>System Settings → Apple Account → iCloud → Photos</strong
				>). Photo Export reads your local Photos library, so your iCloud photos
				need to be syncing to this Mac.
			</p>
			<div class="steps">
				<div class="step">
					<div class="step-number">1</div>
					<h3>Grant access & pick a folder</h3>
					<p>
						Authorize Photos library access and choose a destination folder on
						any local or external drive.
					</p>
				</div>
				<div class="step">
					<div class="step-number">2</div>
					<h3>Browse your library</h3>
					<p>
						Switch the sidebar between two views: a <strong
							>year-and-month</strong
						>
						timeline, or your <strong>Favorites and albums</strong> straight from
						Photos. Preview thumbnails and inspect individual photos before exporting.
					</p>
				</div>
				<div class="step">
					<div class="step-number">3</div>
					<h3>Export</h3>
					<p>
						Hit export and the app copies original files into an organized
						folder tree — <code>Year/Month/</code> for the timeline,
						<code>Collections/Favorites/</code> or <code
							>Collections/Albums/&lt;Album&gt;/</code
						> for collections. Track progress in real time.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Screenshots -->
	<section class="section section-alt" aria-labelledby="screenshots">
		<div class="container">
			<h2 id="screenshots">Screenshots</h2>
			<div class="screenshot-wrapper">
				<Image
					src={screenshot}
					alt="Photo Export app on macOS, showing the year/month sidebar, a thumbnail grid for the selected month, and a full-size photo preview"
					class="screenshot"
					widths={[600, 900, 1200]}
					sizes="(max-width: 768px) 100vw, 900px"
				/>
				<p class="screenshot-caption">
					Timeline view shown above. The sidebar's <strong>Collections</strong>
					tab lists your Favorites and every album you've created in Photos — pick
					one and click <strong>Export Album</strong>.
				</p>
			</div>
		</div>
	</section>

	<!-- Built with community feedback -->
	<section class="section" aria-labelledby="community-feedback">
		<div class="container">
			<h2 id="community-feedback">Shipped from real-world feedback</h2>
			<p class="section-lead">
				Photo Export improves on what users actually report. Recent releases
				added <strong>album and Favorites export</strong>, <strong>backup-folder
				import</strong> to rebuild export state from an existing folder, and the
				<strong>Include originals</strong> toggle for keeping unedited copies of
				edited photos. See the <a
					href="https://github.com/valtteriluomapareto/photo-export/releases"
					>release notes</a
				> for the full history.
			</p>
			<p class="section-lead">
				If something doesn't work the way you expect, <a
					href="https://github.com/valtteriluomapareto/photo-export/issues"
					>open an issue</a
				> — bug reports and feature suggestions are read and acted on.
			</p>
		</div>
	</section>

	<!-- Known limitations -->
	<section class="section section-alt" aria-labelledby="limitations">
		<div class="container">
			<h2 id="limitations">Known limitations</h2>
			<p class="section-lead">
				Backup tools should be honest about what they don't do yet. Here's what
				to expect today:
			</p>
			<ul class="limitations-list">
				<li>
					<strong>Requires macOS 15.0 or later.</strong>
				</li>
				<li>
					<strong>Live Photos export as still images.</strong> Paired image + video
					export is planned for a future release.
				</li>
				<li>
					<strong>Albums and Favorites are supported.</strong> Smart albums other
					than Favorites, and shared albums, are not currently included.
				</li>
				<li>
					<strong>Edited photos export as the version Photos shows you</strong>,
					at the original filename. Turn on <strong>Include originals</strong> to
					also keep an <code>_orig</code> companion with the original bytes.
				</li>
			</ul>
		</div>
	</section>

	<!-- Installation -->
	<section class="section" aria-labelledby="installation">
		<div class="container">
			<h2 id="installation">Download &amp; install</h2>
			<p class="section-lead">
				<strong>Free from GitHub.</strong> <strong>Paid on the Mac App Store</strong>
				if you want automatic updates and to support development. Same app,
				same features — both signed and notarized by Apple.
			</p>
			<div class="install-channels">
				<div class="install-channel">
					<h3>GitHub Releases (free)</h3>
					<ol>
						<li>
							Download the latest <code>.dmg</code> from <a
								href="https://github.com/valtteriluomapareto/photo-export/releases"
								>GitHub Releases</a
							>
						</li>
						<li>
							Open the DMG and drag Photo Export to your Applications folder
						</li>
						<li>
							Launch the app and grant Photos library access when prompted
						</li>
					</ol>
				</div>
				<div class="install-channel">
					<h3>Mac App Store (paid)</h3>
					<p>
						Install directly from the <a
							href="https://apps.apple.com/app/photo-export-local-backup/id6761410742"
							>Mac App Store</a
						> for automatic updates and trusted distribution. Your purchase
						supports continued development of an open-source project.
					</p>
				</div>
			</div>
			<div class="requirements">
				<strong>Requirements:</strong> macOS 15.0+. Both versions are signed and
				notarized by Apple and identical in functionality.
			</div>
		</div>
	</section>

	<!-- Roadmap -->
	<section class="section section-alt" aria-labelledby="roadmap">
		<div class="container">
			<h2 id="roadmap">Ideas for the future</h2>
			<ul class="roadmap-list">
				<li>Concurrent export pipeline for faster throughput</li>
				<li>iCloud originals handling (download or skip remote-only photos)</li>
				<li>Live Photos and paired media support</li>
				<li>Retry failed exports without restarting the batch</li>
				<li>Media filtering and search within the library browser</li>
				<li>Flexible naming schemes beyond year/month</li>
			</ul>
			<p><a href={`${base}/roadmap`}>See all ideas &rarr;</a></p>
			<p class="feedback-cta">
				Missing a feature? <a
					href="https://github.com/valtteriluomapareto/photo-export/issues"
					>Open an issue on GitHub</a
				> and let us know what you need.
			</p>
		</div>
	</section>

	<!-- FAQ -->
	<section class="section" aria-labelledby="faq">
		<div class="container">
			<h2 id="faq">Frequently Asked Questions</h2>
			<dl class="faq-list">
				<div class="faq-item">
					<dt>Does this work with iCloud Photo Library?</dt>
					<dd>
						Yes. Photo Export reads your Apple Photos library, which includes
						all photos synced via iCloud. It can also download iCloud originals
						that are stored remotely on demand during export.
					</dd>
				</div>
				<div class="faq-item">
					<dt>Can I export photos to an external hard drive?</dt>
					<dd>
						Absolutely. You can choose any local or external drive as your
						export destination. The app remembers your choice across launches.
					</dd>
				</div>
				<div class="faq-item">
					<dt>Will it download iCloud originals that are stored remotely?</dt>
					<dd>
						Yes. During export, the app automatically downloads originals from
						iCloud when they aren't stored locally on your Mac. No manual
						downloading required.
					</dd>
				</div>
				<div class="faq-item">
					<dt>Is it free?</dt>
					<dd>
						Photo Export is free and open source on <a
							href="https://github.com/valtteriluomapareto/photo-export/releases"
							>GitHub Releases</a
						>. It's also available as a paid app on the Mac App Store — the
						purchase supports ongoing development. Both versions are identical
						in functionality.
					</dd>
				</div>
				<div class="faq-item">
					<dt>Does it export videos too?</dt>
					<dd>
						Yes. The app exports photos and videos. Live Photos are exported as
						a single still image — full motion export (paired image + video) is
						planned for a future release.
					</dd>
				</div>
				<div class="faq-item">
					<dt>How do I export a single album from Apple Photos?</dt>
					<dd>
						Yes — you can export your <strong>Favorites</strong> or any individual
						album to its own folder on your drive. Photo Export lists everything you've
						created in Photos under a <strong>Collections</strong>
						tab in the sidebar; pick one and click <strong>Export</strong>.
						Albums land at <code>Collections/Albums/&lt;Album&gt;/</code> (folder
						hierarchy preserved); Favorites land at <code
							>Collections/Favorites/</code
						>. Smart albums other than Favorites and shared albums aren't
						included. Timeline (year/month) export still works exactly as
						before.
					</dd>
				</div>
				<div class="faq-item">
					<dt>What about photos I have edited in Photos?</dt>
					<dd>
						By default, Photo Export saves the version Photos shows you — edits
						and all — at the original filename. Turn on <strong
							>Include originals</strong
						> in the toolbar to also keep an original-bytes copy as a <code
							>_orig</code
						> companion (e.g. <code>IMG_0001_orig.HEIC</code> alongside <code
							>IMG_0001.JPG</code
						>).
					</dd>
				</div>
				<div class="faq-item">
					<dt>What happens if the export is interrupted?</dt>
					<dd>
						The app tracks every exported photo. If the export is interrupted,
						you can resume and it will skip most already-exported files. In rare
						cases (e.g. a crash mid-write), a file may be copied again.
					</dd>
				</div>
			</dl>
		</div>
	</section>

	<!-- CTA -->
	<section class="section cta-section" aria-labelledby="get-started">
		<div class="container">
			<h2 id="get-started">Get started</h2>
			<p>
				Download Photo Export, grant Photos access, and start backing up your
				library today. Free on GitHub, or support the project on the Mac App
				Store.
			</p>
			<div class="cta-actions">
				<a
					href="https://apps.apple.com/app/photo-export-local-backup/id6761410742"
					class="btn btn-primary">Download on the Mac App Store</a
				>
				<a
					href="https://github.com/valtteriluomapareto/photo-export/releases"
					class="btn btn-secondary">Download from GitHub (free)</a
				>
				<a href={`${base}/getting-started`} class="btn btn-secondary"
					>Read the docs</a
				>
			</div>
			<p class="feedback-note">
				Found a bug or have feedback? <a
					href="https://github.com/valtteriluomapareto/photo-export/issues"
					>We'd love to hear from you.</a
				>
			</p>
		</div>
	</section>

	<Footer />
</MarketingLayout>

<style>
	.value-props {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}

	.value-prop {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.value-prop strong {
		font-size: 1.05rem;
	}

	.section-lead {
		max-width: 40rem;
		margin: 0 auto 1rem;
		color: var(--site-muted);
		font-size: 1rem;
		line-height: 1.7;
		text-align: center;
	}

	.section-lead:last-of-type {
		margin-bottom: 2.5rem;
	}

	.value-prop span {
		color: var(--site-muted);
		font-size: 0.95rem;
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		text-align: center;
		margin-top: 2rem;
	}

	.step-number {
		width: 2.5rem;
		height: 2.5rem;
		background: var(--site-accent);
		color: white;
		border-radius: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		font-size: 1.1rem;
		margin: 0 auto 0.75rem;
	}

	.step h3 {
		font-size: 1.1rem;
		margin-bottom: 0.5rem;
	}

	.step p {
		color: var(--site-muted);
		font-size: 0.95rem;
	}

	.section-note {
		text-align: center;
		color: var(--site-muted);
		font-style: italic;
		max-width: 36rem;
		margin: 0 auto;
	}

	.install-channels {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
		margin-bottom: 1.5rem;
	}

	.install-channel {
		background: var(--site-surface);
		border: 1px solid var(--site-border);
		border-radius: 12px;
		padding: 1.5rem;
	}

	.install-channel h3 {
		font-size: 1.15rem;
		margin-bottom: 0.75rem;
	}

	.install-channel p {
		color: var(--site-muted);
		font-size: 0.95rem;
	}

	.install-channel ol {
		margin-left: 1.5rem;
		margin-bottom: 0;
	}

	.install-channel li {
		margin-bottom: 0.5rem;
	}

	.requirements {
		background: var(--site-surface-accent);
		border-left: 3px solid var(--site-accent);
		padding: 0.75rem 1rem;
		border-radius: 0 8px 8px 0;
		font-size: 0.95rem;
	}

	.roadmap-list {
		margin-left: 1.5rem;
		margin-bottom: 1rem;
	}

	.roadmap-list li {
		margin-bottom: 0.5rem;
		color: var(--site-muted);
	}

	.limitations-list {
		max-width: 42rem;
		margin: 1rem auto 0;
		padding-left: 1.25rem;
	}

	.limitations-list li {
		margin-bottom: 0.75rem;
		color: var(--site-muted);
		line-height: 1.55;
	}

	.limitations-list strong {
		color: var(--site-text);
	}

	.feedback-cta {
		text-align: center;
		margin-top: 1.5rem;
		color: var(--site-muted);
		font-size: 0.95rem;
	}

	.feedback-cta a {
		color: var(--site-accent);
		text-decoration: none;
		font-weight: 600;
	}

	.feedback-cta a:hover {
		text-decoration: underline;
	}

	.feedback-note {
		margin-top: 1rem;
		font-size: 0.9rem;
	}

	.feedback-note a {
		color: rgba(255, 255, 255, 0.9);
		text-decoration: underline;
	}

	.cta-section {
		text-align: center;
		background: var(--site-brand-gradient);
		color: white;
	}

	.cta-section h2 {
		color: white;
	}

	.cta-section p {
		opacity: 0.85;
		margin-bottom: 1.5rem;
		font-size: 1.05rem;
	}

	.cta-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.faq-list {
		max-width: 42rem;
		margin: 0 auto;
	}

	.faq-item {
		margin-bottom: 1.5rem;
	}

	.faq-item dt {
		font-weight: 700;
		font-size: 1.05rem;
		margin-bottom: 0.35rem;
	}

	.faq-item dd {
		color: var(--site-muted);
		font-size: 0.95rem;
		margin-left: 0;
		line-height: 1.6;
	}

	.screenshot-wrapper {
