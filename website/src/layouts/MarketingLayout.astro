---
import '../styles/site.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalUrl = Astro.site
	? new URL(Astro.url.pathname, Astro.site).toString()
	: Astro.url.toString();
const socialImageUrl = new URL(
	`${base}/app-icon.png`,
	Astro.site ?? Astro.url,
).toString();

// `softwareVersion` lags MARKETING_VERSION (in `project.pbxproj`) intentionally
// while a release is in flight: bump this to the new semver when you tag
// `vX.Y.Z` so that crawlers and LLMs see the same number the App About box shows.
// The website docs typically lead the bump by a day or two — that's fine; users
// of search/AI care about the latest documented capabilities, not the in-app
// MARKETING_VERSION constant.
const softwareVersion = '1.6.3';
// Rebuilt on every deploy, so AI crawlers see a freshness signal that tracks the
// actual publication time of the static site rather than a stale checked-in date.
const dateModified = new Date().toISOString().split('T')[0];

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Photo Export',
	description,
	operatingSystem: 'macOS 15+',
	applicationCategory: 'PhotographyApplication',
	softwareVersion,
	dateModified,
	featureList: [
		'Export by year and month (Timeline view)',
		'Export Favorites, user albums, and album folders (Collections view)',
		'Export iCloud Shared Albums (reduced quality — Apple constraint)',
		'Auto Export — automatic background sync with scope selection',
		'Include originals for edited photos (opt-in)',
		'Convert HEIC to JPEG on export (opt-in)',
		'Export Live Photos as paired image + video (opt-in)',
		'Separate standalone videos into a subfolder (opt-in)',
		'Import an existing backup folder to rebuild local export state',
		'Per-destination tracking with resume-safe interrupted exports',
		'Pause, resume, and cancel queued exports',
		'Diagnostic report export for failed exports',
	],
	offers: [
		{
			'@type': 'Offer',
			price: '4.99',
			priceCurrency: 'EUR',
			name: 'Mac App Store',
			url: 'https://apps.apple.com/app/photo-export-local-backup/id6761410742',
		},
		{
			'@type': 'Offer',
			price: '0',
			priceCurrency: 'USD',
			name: 'GitHub Releases (free)',
			url: 'https://github.com/valtteriluomapareto/photo-export/releases',
		},
	],
	license: 'https://opensource.org/licenses/MIT',
	url: canonicalUrl,
	image: socialImageUrl,
	downloadUrl: [
		'https://apps.apple.com/app/photo-export-local-backup/id6761410742',
		'https://github.com/valtteriluomapareto/photo-export/releases',
	],
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0f3460" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:alt" content="Photo Export app icon" />
		<meta property="og:site_name" content="Photo Export" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta
			name="keywords"
			content="iCloud photos export, Apple Photos backup, export photos to external drive, macOS photo export, free photo backup app, iCloud photo backup, download iCloud photos"
		/>
		<script
			type="application/ld+json"
			set:html={JSON.stringify(structuredData)}
		/>
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<main id="main-content">
			<slot />
		</main>
	</body>
</html>
